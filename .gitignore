# .gitignore for .NET Projects

#
# Binaries, artifacts, and generated files
#
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.suo
*.user
*.pdb
*.suo.bak
[Aa]utogenerated.cs
[Gg]enerated.cs
[Tt]emp/
*.tmp
*.log
artifacts/
project.lock.json
project.fragment.lock.json

#
# Visual Studio files and folders
#
.vs/
*.vspscc
*.vssscc
*.suo
*.user
*.suo.bak
*.vsp
*.vspx
*.vsmdi
*.dbmdl
.vs/
.vspscc
.vssscc
**/Properties/launchSettings.json
PublishProfiles/

#
# NuGet packages
#
packages/
*.nupkg
.nuget/
*.cache
*.props
*.targets

#
# Rider (JetBrains IDE)
#
.idea/
.rd/
*.iml

#
# Visual Studio Code
#
.vscode/

#
# Configuration files with sensitive data
#
appsettings.json
appsettings.Local.json
appsettings.Production.json
*.secrets.json
.env
.env.local
.env.production

#
# Local database files
#
*.db
*.sqlite
*.sqlite3
*.mdf
*.ldf
LocalDB/

#
# Test results and coverage
#
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml


#
# OS generated files
#
.DS_Store
*.[Dd]s[Ss]tore
Thumbs.db
*.[Tt]humbs.db
ehthumbs.db
Desktop.ini
