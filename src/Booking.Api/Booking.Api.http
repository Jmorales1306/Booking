# Bookings

# GET all bookings
GET {{api_HostAddress}}/api/Booking

###

# GET booking by ID
GET {{api_HostAddress}}/api/Booking/1

###

# POST a new booking
POST {{api_HostAddress}}/api/Booking
Content-Type: application/json

{
  "date": "2025-09-15",
  "startTime": "14:00:00",
  "endTime": "15:00:00",
  "roomId": 1,
  "userId": 1,
  "clientId": 1
}

###

# PUT to update a booking
PUT {{api_HostAddress}}/api/Booking/1
Content-Type: application/json


{
  "id": 1,                         
  "date": "2025-07-20",            
  "startTime": "10:00:00",        
  "endTime": "11:30:00",    
  "roomId": 1,
  "userId": 1,
  "clientId": 1
}

###

# DELETE a booking
DELETE {{api_HostAddress}}/api/Booking/1