@api_HostAddress = http://localhost:5268

###

# Locations

# GET all locations
GET {{api_HostAddress}}/api/Location

###

# GET location by ID
GET {{api_HostAddress}}/api/Location/1

###

# POST a new location
POST {{api_HostAddress}}/api/Location
Content-Type: application/json

{
  "name": "Sala de Conferencias Principal",
  "address": "123 Calle ciudad sandino, Ciudad Gótica",
  "description": "Ubicación central con múltiples salas."
}

###

# PUT to update a location
PUT {{api_HostAddress}}/api/Location/1
Content-Type: application/json

{
  "id": 1,
  "name": "Sala de Conferencias Norte",
  "address": "456 Avenida Siempre Viva, Ciudad Gótica",
  "description": "Ubicación renovada en el ala norte."
}

###

# DELETE a location
DELETE {{api_HostAddress}}/api/Location/1

###

# Clients

# GET all clients
GET {{api_HostAddress}}/api/Client

###

# GET client by ID
GET {{api_HostAddress}}/api/Client/1

###

# POST a new client
POST {{api_HostAddress}}/api/Client
Content-Type: application/json

{
  "firstName": "Juan",
  "lastName": "Pérez",
  "email": "juan.perez@example.com",
  "phoneNumber": "123-456-7890"
}

###

# PUT to update a client
PUT {{api_HostAddress}}/api/Client/1
Content-Type: application/json

{
  "id": 1,
  "firstName": "Juan Alberto",
  "lastName": "Pérez Gómez",
  "email": "juan.perez.new@example.com",
  "phoneNumber": "098-765-4321"
}

###

# DELETE a client
DELETE {{api_HostAddress}}/api/Client/1

